# ── Database (Supabase Postgres) ──
# Settings → Database → Connection string (copy the full URI as-is)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── Supabase API (Settings → API Keys) ──
SUPABASE_URL=https://[PROJECT_REF].supabase.co
# Client-side safe, RLS-restricted — use in things equivalent to frontend/public contexts
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backend only — bypasses RLS, never expose to the app/client
SUPABASE_SECRET_KEY=sb_secret_...

# ── Auth (Clerk) ──
# Clerk Dashboard → API Keys
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Clerk Dashboard → Configure → API Keys (or your instance's .well-known endpoint)
CLERK_JWKS_URL=https://[your-instance].clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://[your-instance].clerk.accounts.dev
CLERK_WEBHOOK_SIGNING_SECRET=...

# ── Push Notifications (Expo) ──
# expo.dev → Account Settings → Access Tokens (optional but raises rate limits)
EXPO_ACCESS_TOKEN=...

# ── Redis (only if using Celery for background jobs) ──
# Free option: Upstash, or run locally via Docker for dev
REDIS_URL=redis://localhost:6379/0

# ── Stripe (only if building the settle-up stretch feature) ──
# Stripe Dashboard → Developers → API Keys (use test mode keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── General app config ──
ENVIRONMENT=development
# Comma-separated list — needs your Expo dev server URL so RN app can reach FastAPI locally
CORS_ORIGINS=http://localhost:8081,exp://x.x.x.x:8081
